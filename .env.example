# Application metadata/event database. Use MySQL in deployment.
DATABASE_URL=mysql+pymysql://dq_user:replace_me@127.0.0.1:3306/dq_agent?charset=utf8mb4
# Optional Oracle-compatible read-only business database.
BUSINESS_DATABASE_URL=oracle+oracledb://report_reader:replace_me@127.0.0.1:1521/?service_name=FREEPDB1
ORACLE_SANDBOX_URL=oracle+oracledb://DQ_SANDBOX:replace_me@127.0.0.1:1521/?service_name=FREEPDB1
BUSINESS_ALLOWED_TABLES=SAFE_ORG_BASE
BLOB_DIR=./var/blobs
LLM_PROVIDER=scripted
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=GLM-5.3-Flash
LLM_API_KEY=replace_with_a_new_rotated_key
