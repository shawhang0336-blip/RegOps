# Application metadata/event database. Use MySQL in deployment.
DATABASE_URL=mysql+pymysql://dq_user:replace_me@127.0.0.1:3306/dq_agent?charset=utf8mb4
# Optional Oracle-compatible read-only business database and validation sandbox.
BUSINESS_DATABASE_URL=oracle+oracledb://report_reader:replace_me@127.0.0.1:1521/?service_name=FREEPDB1
ORACLE_SANDBOX_URL=oracle+oracledb://DQ_SANDBOX:replace_me@127.0.0.1:1521/?service_name=FREEPDB1
BUSINESS_ALLOWED_TABLES=SAFE_ORG_BASE
BLOB_DIR=./backend/var/blobs
# Optional: override default SAFE 1.3 spec PDF path (defaults to ./data/specs/金融机构外汇业务数据采集规范_1.3版_全文.pdf)
# SAFE_13_SPEC_PATH=./data/specs/金融机构外汇业务数据采集规范_1.3版_全文.pdf
LLM_PROVIDER=scripted
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-plus
LLM_API_KEY=replace_with_a_new_rotated_key
# 是否启用 thinking 推理增强；留空 = 不发送 thinking 参数（默认，推荐）。
# 实测硬编码 {"type":"low"} 会触发部分请求 400（code 1210）并拉高延迟。
LLM_THINKING=
# LLM 单次工具调用超时（秒）。默认 120s 覆盖复杂字段波动。
LLM_TIMEOUT=120
# tool_choice 模式：auto（默认，兼容 deepseek thinking）/ forced（GLM 可用）
LLM_TOOL_CHOICE=auto
# 结构切块交给 AI 的范围：adaptive（默认，仅处理有判断空间的章节）/ all
STRUCTURE_AI_SCOPE=adaptive
